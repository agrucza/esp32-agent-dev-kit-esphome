# Copy to secrets.yaml and fill in. secrets.yaml is git-ignored.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# Generate with: openssl rand -base64 32
api_encryption_key: "replace-me-with-a-base64-32-byte-key"

# Fallback access point password (OTA uses the API key for encryption)
ap_password: "change-me"
